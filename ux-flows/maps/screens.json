  "defaults": "viewMode=2d",
  "groups": [
    {
      "id": "compare",
      "label": "Compare two sources",
      "summary": "Split, overlay and blend two views over the Veluwe: Esri imagery on A, Google on B, Mapterhorn vs AHN 0.5 m terrain. The Compare and Blend section is open and scrolled to."
    },
    {
      "id": "compare.overlay",
      "parent": "compare",
      "label": "Overlay"
    },
    {
      "id": "compare.side",
      "parent": "compare",
      "label": "Side by side"
    },
    {
      "id": "relief",
      "label": "Relief visualization",
      "summary": "Local relief model, sky-view factor and openness over the Matterhorn (Mapterhorn, 2D), with the Relief Visualization section open."
    },
    {
      "id": "picker",
      "label": "Elevation picker and slicer",
      "summary": "Tools: Elevation Picker over Zermatt. Two picked points, their profile in the side panel and docked under the map, routed paths, line of sight with a mast, then the plane slicer. Picks are app actions scripted with agent-browser, not URL state."
    }
  ],
