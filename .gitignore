# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

/dist

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...but the documented template is tracked, so the variable list is discoverable
!.env.example

# vercel
.vercel

# Claude Code tooling — ignore local settings but track shared project context
/.claude/settings.json
/.claude/settings.local.json
# .claude/CLAUDE.md and .claude/memory/ are intentionally tracked

# typescript
*.tsbuildinfo
next-env.d.ts.cache

# Intermediate coverage decodes (docs/scripts/google3d-coverage.ts): hundreds of MB
.cache/

# Generated by docs/scripts/build-stac-catalog.mjs (docs build)
docs/public/stac/

# Generated by docs/scripts/build-eli-contribution.mjs
docs/public/eli-contribution/

# open-slide workspace (slides/): its own install, outside the pnpm workspace
slides/node_modules/
slides/dist/
slides/.open-slide/
# Remotion workspace (video/): its own install; recordings and renders are local
video/node_modules/
video/out/
video/recordings/
video/public/clip-*.mp4
