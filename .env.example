# Copy to `.env` (gitignored) and fill in whichever you have. Every one is
# OPTIONAL: the app ships keyless and every default source works without any of
# them. A variable here only pre-fills the matching field in Settings — the
# value is still stored per-browser in localStorage, and is never put in a URL
# or a shared link.
#
# Vite only exposes variables prefixed VITE_, and it inlines them at BUILD time,
# so anything set here ends up readable in the deployed bundle. Do not put a key
# with billing exposure in a build you publish; let visitors paste their own in
# Settings instead.

# --- Terrain and basemap providers (Settings → API Keys) -------------------

# Mapbox Terrain-DEM v1 and Mapbox Satellite.
VITE_MAPBOX_ACCESS_TOKEN=

# MapTiler Terrain-RGB v2 and MapTiler basemaps.
VITE_MAPTILER_API_KEY=

# Cesium ion. Gates Cesium World Terrain as a built-in terrain source and any
# private ion asset: every ion asset answers 401 without a token.
# Free token: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# HERE Satellite basemap. Hidden until set.
VITE_HERE_API_KEY=

# Planet monthly mosaics, as a historical basemap. Hidden until set.
VITE_PLANET_API_KEY=

# Google APIs (Street View / Open-In destinations).
VITE_GOOGLE_API_KEY=

# --- Sharing (no Settings field today: env-only) ---------------------------

# ImgBB, used to host snapshot thumbnails behind a shared link.
VITE_IMGBB_API_KEY=

# dub.co, used to shorten shared links.
VITE_DUB_API_KEY=

# Umami Cloud website id (Settings > Websites > Edit > Website ID). The tracker
# is only loaded when this is set, and only on the real hostnames; a clone
# built without it reports nowhere. The deploy writes it from the
# ENV_FILE_CONTENT secret.
VITE_UMAMI_WEBSITE_ID=

# --- Scripts and agents (not read by the app build) ------------------------

# Bing Webmaster Tools API key (Settings > API access), read by
# scripts/bing-webmaster.mjs for the site's search data.
BING_WEBMASTER_API_KEY=

# Path to a Google service-account JSON key (a user of the Search Console
# property), read by scripts/search-console.mjs. Keep the file outside the repo.
GOOGLE_SEARCH_CONSOLE_KEY_FILE=
