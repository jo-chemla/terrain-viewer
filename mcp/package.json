{
  "name": "terrain-viewer-mcp",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "MCP server for Terrain Viewer: tools that compose a view, and an MCP App that shows it in the chat. Renders with the tile service's engine (../tile-server), installed separately.",
  "scripts": {
    "build": "node ../tile-server/build.mjs",
    "prestart": "node ../tile-server/build.mjs",
    "start": "node server.mjs",
    "stdio": "node server.mjs --stdio",
    "pretest": "node ../tile-server/build.mjs",
    "test": "node test.mjs",
    "host": "node host-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "geotiff": "^3.0.5",
    "zod": "^4.6.7"
  }
}
