    "tw-animate-css": "^1.4.0",
    "tz-lookup": "^6.1.25",
    "uuid": "^13.0.0",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vt-pbf": "^3.1.3",
