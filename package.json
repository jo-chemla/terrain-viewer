    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "@types/d3-contour": "^3.0.6",
    "@types/file-saver": "2.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/tinycolor2": "^1.4.6",
    "@types/tz-lookup": "^6.1.2",
    "@types/vt-pbf": "^3.1.1",
    "concurrently": "^10.0.5",
    "ffmpeg-static": "^5.3.0",
    "knip": "^6.40.0",
    "react-scan": "^0.5.7",
