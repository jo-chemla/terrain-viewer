    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coachmark": "^0.1.1",
    "d3-contour": "^4.0.2",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "file-saver": "2.0.5",
    "geogrid-maplibre-gl": "^0.2.4",
    "geotiff": "^2.x",
    "jiti": "2.7.0",
    "jotai": "2.20.2",
    "lerc": "^4.2.0",
