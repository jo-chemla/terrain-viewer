{
  "name": "terrain-visualization-modes",
  "version": "0.1.0",
  "author": "jochemla",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,docs -c cyan,magenta \"pnpm run app\" \"pnpm run docs\"",
    "app": "vite",
    "docs": "pnpm --dir docs dev",
    "build": "node scripts/build-seo.mjs && vite build",
    "seo": "node scripts/build-seo.mjs",
    "zip": "del dist.zip && vite build && \"C:\\Program Files\\7-Zip\\7z.exe\" a dist.zip dist",
    "preview": "vite preview",
    "shadcn:add": "shadcn add -b base",
    "docs:install": "pnpm --dir docs install",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs start",
    "slides": "pnpm --dir slides dev",
    "slides:install": "pnpm --dir slides install --ignore-workspace",
    "slides:build": "pnpm --dir slides build",
    "slides:static": "pnpm --dir slides static",
    "slides:pdf": "pnpm --dir slides pdf",
    "dev:all": "concurrently -k -n app,docs,slides -c cyan,magenta,yellow \"pnpm run app\" \"pnpm run docs\" \"pnpm run slides\"",
    "url-params": "node docs/scripts/build-url-params.mjs",
    "stac": "node docs/scripts/build-stac-catalog.mjs",
    "bing-3d-coverage": "node docs/scripts/build-bing-3d-coverage.mjs",
    "google-3d-coverage": "node docs/scripts/build-google-3d-coverage.mjs",
    "google-3d-fetch": "tsx docs/scripts/google3d-coverage.ts fetch --key $GOOGLE_KEY --out .cache/google3d --zoom 8 --conc 24 && tsx docs/scripts/google3d-coverage.ts decode --tiles .cache/google3d --out .cache/google3d-z8.geojson --zoom 8",
    "screenshot-thumbs": "node docs/scripts/build-screenshot-thumbs.mjs",
    "google-3d-dissolve": "node --max-old-space-size=8192 docs/scripts/dissolve-google-3d-coverage.mjs .cache/google3d-z8.geojson",
    "flai-coverage": "node docs/scripts/build-flai-coverage.mjs",
    "esri-3d-coverage": "node docs/scripts/build-esri-3d-coverage.mjs",
    "opentopo-coverage": "node scripts/build-opentopo-coverage.mjs",
    "open-buildings-vrt": "node docs/scripts/build-open-buildings-vrt.mjs"
  },
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@allmaps/maplibre": "1.0.0-beta.44",
    "@allmaps/transform": "1.0.0-beta.53",
    "@base-ui/react": "^1.8.0",
    "@esri/wayback-core": "^1.1.0",
    "@geomatico/maplibre-cog-protocol": "^0.10.0",
    "@loaders.gl/core": "^4.5.3",
    "@loaders.gl/flatgeobuf": "^4.5.3",
    "@loaders.gl/geopackage": "^4.5.3",
    "@loaders.gl/shapefile": "^4.5.3",
    "@loaders.gl/terrain": "^4.5.3",
    "@loaders.gl/wms": "^4.5.3",
    "@mapbox/vector-tile": "2.0.4",
    "@maplibre/maplibre-gl-geocoder": "1.9.4",
    "@osm-editor-kit/maplibre-editor-layer-index": "^0.1.14",
    "@remix-run/react": "2.17.5",
    "@sugar-high/react": "^1.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/devtools-vite": "^0.3.11",
